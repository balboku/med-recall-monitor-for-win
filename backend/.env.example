GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=

# Optional PostgreSQL connection string. Leave empty to use SQLite.
# DATABASE_URL=postgresql://user:password@localhost:5432/medwatch

# Local mode does not require Redis, but keeping the value here preserves
# compatibility if you later switch TASK_QUEUE_MODE to celery.
REDIS_URL=redis://localhost:6379/0

TASK_QUEUE_MODE=local
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
